# EditorConfig — https://editorconfig.org
root = true

[*]
end_of_line = crlf
insert_final_newline = true

# T-SQL scripts: UTF-8 with BOM so SSMS always reads Thai comments correctly
[*.sql]
charset = utf-8-bom

# Expected-result files may be generated by SSMS and contain alignment spaces
[*.txt]
charset = utf-8-bom
trim_trailing_whitespace = false

[*.{md,slnx,ssmssqlproj}]
charset = utf-8
trim_trailing_whitespace = true
